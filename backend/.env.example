# ─── Server ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database ───────────────────────────────────────────────────────
# SQLite (dev). For prod, switch to PostgreSQL.
DATABASE_URL="file:./prisma/dev.db"

# ─── Auth ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_in_prod_at_least_64_random_hex_chars
JWT_REFRESH_SECRET=change_me_too_another_64_random_hex_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_COST=12

# ─── Cookies ────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ─── Rate limits ────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_LOGIN=5
RATE_LIMIT_AVAILABILITY=60
RATE_LIMIT_HOLD=10

# ─── Redis (optional) ───────────────────────────────────────────────
# Leave empty to use the per-process in-memory store. Set to a Redis URL to
# share rate-limit state across backend instances. Required in prod when
# running >1 backend pod.
# Examples:
#   REDIS_URL=redis://localhost:6379
#   REDIS_URL=rediss://:password@your-redis-host:6380
REDIS_URL=

# ─── Payments (Razorpay) ────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── WhatsApp / SMS ─────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ─── Hold expiry ────────────────────────────────────────────────────
HOLD_DURATION_MINUTES=10
HOLD_EXPIRY_CHECK_INTERVAL_SEC=60

# ─── Frontend URL (for CORS + emails) ───────────────────────────────
FRONTEND_URL=http://localhost:3000
