# ─── Frontend ────────────────────────────────────────────────────────
# Local development only. Copy to frontend/.env.local.

# Backend API base URL (empty = use mock data)
NEXT_PUBLIC_API_BASE_URL=

# Public site origin (used for absolute URLs, OG tags, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resort phone (for click-to-call, WhatsApp link)
NEXT_PUBLIC_RESORT_PHONE=+919876543210

# Resort WhatsApp number (digits only, no + or spaces)
NEXT_PUBLIC_WHATSAPP=919876543210

# Map / analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=
